# Credential-free demo (recommended for first run)
AGENT_MODE=demo
# Set AGENT_MODE=ai AND supply a private key to call Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
FRONTEND_ORIGIN=http://localhost:3000

# Phase 2: required for authenticated workspace endpoints
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Phase 3: RAG uses the same private GOOGLE_API_KEY as LangChain AI
RAG_SIMILARITY_THRESHOLD=0.35

# Maximum investigation execution time, seconds (5-120)
GRAPH_TIMEOUT_SECONDS=30
